# MySQL Configuration
MYSQL_DB_PWD=123456
MYSQL_DB_USER=root
MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=media_crawler

# Redis Configuration
REDIS_DB_HOST=127.0.0.1
REDIS_DB_PWD=123456
REDIS_DB_PORT=6379
REDIS_DB_NUM=0

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PWD=
MONGODB_DB_NAME=media_crawler

# PostgreSQL Configuration
POSTGRES_DB_PWD=123456
POSTGRES_DB_USER=postgres
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=media_crawler

# Docker / VPS: Douyin growth snapshot schedule (seeded on API startup)
DY_APP_PORT=8085
BILI_APP_PORT=8086
XHS_APP_PORT=8087
GZH_APP_PORT=8088
# Keep platform cookies outside source files. BILI_CREATOR_IDS accepts comma-separated UIDs or space URLs.
DY_COOKIES=
BILI_COOKIES=
BILI_CREATOR_IDS=
BILI_SPECIFIED_IDS=
# XHS pure API accepts a creator user_id or a complete profile URL with xsec_token and xsec_source.
# Preferred in Docker: put the full Cookie into ./secrets/xhs_cookies (mode 0600) for hot reload.
XHS_COOKIES_FILE=/run/secrets/xhs_cookies
XHS_COOKIES_RUNTIME_FILE=/app/data/xhs_cookies
XHS_SECRET_DIR_HOST=./secrets
# Fallback only; prefer the secret file so Cookie rotation does not require container recreate.
XHS_COOKIES=
XHS_CREATOR_IDS=
# 公众号（weread-omni）：CLI 路径 + Web Cookie（阅读量）+ 账号列表
# 本地开发填本机 weread-omni 路径；Debian 用 /opt/weread-omni/...
WEREAD_OMNI_CLI=/Users/wenhao/fuwenhao/temp/demo-weread/weread-omni/bin/weread-omni.js
WEREAD_OMNI_HOST_PATH=/Users/wenhao/fuwenhao/temp/demo-weread/weread-omni
WEREAD_CONFIG_HOST_PATH=./data/weread-config
WEREAD_SECRET_DIR_HOST=./secrets
# Preferred in Docker: one Cookie value in ./secrets/weread_web_cookie (mode 0600).
WEREAD_WEB_COOKIE_FILE=/run/secrets/weread_web_cookie
# 浏览器登录 weread.qq.com 后复制 Cookie；过期会出现「登录超时」
WEREAD_WEB_COOKIE=
GZH_WEB_COOKIE=
GZH_ACCOUNT_IDS=
GZH_STATS_LIMIT=20
GZH_ARTICLES_COUNT=20
AUTO_SEED_GZH_SCHEDULE=true
GZH_SCHEDULE_RUN_TIME=11:00
GZH_SCHEDULE_TASK_NAME=公众号每日阅读量快照(自动)
XHS_SAFE_MODE=true
XHS_MAX_PAGES=1
XHS_MAX_CREATORS_PER_RUN=1
XHS_REQUEST_INTERVAL_MIN_SEC=8
XHS_REQUEST_INTERVAL_MAX_SEC=15
# 小红书仅每日一次：自动任务固定单账号、单页、无评论/媒体下载。
AUTO_SEED_XHS_SCHEDULE=true
XHS_SCHEDULE_RUN_TIME=10:30
XHS_SCHEDULE_TASK_NAME=小红书每日安全快照(自动)
AUTO_SEED_DY_SCHEDULE=true
SCHEDULED_CRAWL_PURE_API=true
DY_SCHEDULE_RUN_TIME=09:00,14:00,22:30
DY_SCHEDULE_MAX_PAGES=3
DY_SCHEDULE_SAVE_OPTION=postgres
DY_SCHEDULE_TASK_NAME=抖音增长快照(自动)
# Optional whitelist. Leave empty to auto-load all user_id from douyin_creator.
DY_SCHEDULE_CREATOR_IDS=
# Before each run, refresh creators from douyin_creator when whitelist is empty
DY_SCHEDULE_SYNC_FROM_DB=true
# B站自动增长快照；时区 Asia/Shanghai，支持用逗号配置多个时段
AUTO_SEED_BILI_SCHEDULE=true
BILI_SCHEDULE_RUN_TIME=09:00,14:00,22:30
BILI_SCHEDULE_MAX_PAGES=3
BILI_SCHEDULE_SAVE_OPTION=postgres
BILI_SCHEDULE_TASK_NAME=B站增长快照(自动)
# Optional whitelist. Leave empty to auto-load all user_id from bilibili_up_info.
BILI_SCHEDULE_CREATOR_IDS=
# Before each run, refresh creators from bilibili_up_info when whitelist is empty
BILI_SCHEDULE_SYNC_FROM_DB=true
# Persist scheduler SQLite under ./data when running in Docker
SQLITE_DB_PATH=/app/data/sqlite_tables.db

# Proxy Configuration (Wandou HTTP)
# your_wandou_http_app_key
WANDOU_APP_KEY=

# Proxy Configuration (Kuaidaili)
# your_kuaidaili_secret_id
KDL_SECERT_ID=
# your_kuaidaili_signature
KDL_SIGNATURE=
# your_kuaidaili_username
KDL_USER_NAME=
# your_kuaidaili_password
KDL_USER_PWD=

# Proxy Configuration (Jisu HTTP)
# Get JiSu HTTP IP extraction key value
jisu_key=
# Get JiSu HTTP IP extraction encryption signature
jisu_crypto=
